<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppressions.

  Dependency-Check matches a JAR to a CPE (a *product* identifier) and then applies the
  CVE version ranges attached to that product. A Maven library and an NVD "product" are
  not the same thing, so a runtime jar can inherit an advisory for a build tool or for a
  different artifact entirely. Each entry below records the NVD evidence, not an opinion.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

  <!--
    kotlin-stdlib 2.3.21 -> CVE-2026-53914, scored 9.8 by Dependency-Check.
    NVD: "In JetBrains Kotlin before 2.4.20 code execution was possible via unsafe
    deserialization in the build cache metadata" - CVSS v3.1 base score 6.7 MEDIUM, and
    the flaw is in the build cache / compiler, not in the runtime standard library.
    Two independent problems with this match:
      1. the score Dependency-Check used (9.8) is not NVD's (6.7), so it crossed a
         threshold NVD's own data would not have crossed;
      2. io.github.jetbrains.kotlinx:kotlin-stdlib does not ship the Kotlin build cache,
         so the vulnerable component is not in this artifact at all.
    Corroboration: OSV has no advisory for kotlin-stdlib 2.3.21, Snyk reports 0 issues for
    the tree, and Trivy's scan of the built image reports app/app.jar at 0 vulnerabilities.
  -->
  <suppress>
    <notes><![CDATA[
      CVE-2026-53914 is a Kotlin build-cache vulnerability (NVD: 6.7 MEDIUM, not 9.8);
      the matched artifact is the runtime stdlib, which does not contain that code.
      OSV, Snyk and Trivy all report no advisory for this artifact.
    ]]></notes>
    <!-- The whole group, not one artifact: Dependency-Check matches the CPE
         jetbrains:kotlin, so every Kotlin jar in the tree inherits the same advisory.
         Listing artifacts one at a time just meant kotlin-reflect turned up next. -->
    <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/[^/]+@.*$</packageUrl>
    <cve>CVE-2026-53914</cve>
  </suppress>

  <!--
    kotlin-stdlib-common 1.9.10 -> CVE-2020-29582 (temporary-file permissions).
    NVD's description says "in JetBrains Kotlin before 1.4.21", but the CPE range on the
    same record is versionEndExcluding 2.1.0, which would sweep in 1.9.10. The two
    disagree; the prose is the more specific statement, and 1.9.10 is well past 1.4.21.
  -->
  <suppress>
    <notes><![CDATA[
      CVE-2020-29582 affects Kotlin before 1.4.21 per NVD's description; the record's CPE
      range (<2.1.0) contradicts it and is what produced this match on 1.9.10.
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib-common@.*$</packageUrl>
    <cve>CVE-2020-29582</cve>
  </suppress>

</suppressions>
