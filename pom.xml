<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>sg.edu.ntu</groupId>
    <artifactId>taskflow-api</artifactId>
    <version>1.1.0</version>
    <name>taskflow-api</name>
    <description>TaskFlow - Task Management API (Module 3 assignment)</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.2</spring-ai.version>

        <!--
          Security overrides. These are the names Spring Boot's own
          dependencyManagement reads, so setting one upgrades every artifact in that
          line together rather than pinning a single jar and leaving its siblings on
          the vulnerable version.

          Snyk (CI gate) flagged tomcat-embed-websocket 11.0.25 - one HIGH and one
          CRITICAL, SNYK-JAVA-ORGAPACHETOMCATEMBED-21246252 / -20552494 - and Netty
          4.2.17.Final across netty-codec-http, -classes-quic and -http3, seven HIGH
          findings. Both are transitive, so neither is visible in a diff of this POM.
        -->
        <tomcat.version>11.0.27</tomcat.version>
        <netty.version>4.2.19.Final</netty.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
    </properties>

    <dependencies>
        <!-- Spring Web: @RestController, @RequestMapping, ResponseEntity -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lombok: @Data, @NoArgsConstructor, @AllArgsConstructor -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot DevTools -->
        <!--
          spring-boot-devtools was removed here. It is a development-time tool - automatic
          restart, LiveReload - that this API never uses, and Dependency-Check flagged it
          against spring_boot_tools CVEs that cannot apply to a jar the Spring Boot plugin
          excludes from the fat jar anyway. Removing it shrinks the tree instead of
          suppressing the finding.
        -->

        <!-- Spring AI (needed for Task 6, the summary endpoint) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              The legacy Jackson 2.x line (com.fasterxml) arrives transitively and
              is NOT governed by the jackson-bom.version property above, which now
              controls Jackson 3.x (tools.jackson). Pin it explicitly so the two
              CVE-affected jars move to a fixed release.
            -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.21.7</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.21.7</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>


    <profiles>
    <!--
      Option 5 - OWASP Dependency-Check, the tool named in the assignment brief.
      Kept out of the default build because the first run syncs the NVD feed
      (~250 MB); it belongs in its own CI job with a cache, not in every
      `mvn verify`. Run it by hand with:

        mvn verify -Psecurity -DnvdApiKey=$NVD_API_KEY
    -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>12.1.3</version>
            <configuration>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
              <!--
                failOnError=false: a missing component analyzer is a property of the build
                image (no dotnet runtime, no OSS Index credentials), not a defect in the
                application. It should not fail a security check.
              -->
              <failOnError>false</failOnError>
              <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <suppressionFiles>
                <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
              </suppressionFiles>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
              </formats>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    </profiles>
</project>
